  "components": [
    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "botao-principal",
      "description": "Ação principal da tela.",
      "html": "<button class=\"ds-botao ds-botao-principal\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Cadastrar processo</button>",
      "css": ".ds-botao{display:inline-flex;align-items:center;gap:var(--esp-2);min-height:32px;padding:0 var(--esp-3);border:1px solid transparent;border-radius:var(--canto-botao);font-family:var(--fonte);font-size:var(--tam-base);font-weight:600;cursor:pointer;transition:background-color 150ms var(--curva-saida),border-color 150ms var(--curva-saida)}.ds-botao:focus-visible{outline:2px solid var(--azul);outline-offset:2px}.ds-botao-principal{background:var(--azul);color:var(--folha)}.ds-botao-principal:hover{background:var(--azul-escuro)}"
    },
    {
      "name": "Botão secundário",
      "kind": "button",
      "refersTo": "botao-secundario",
      "description": "Ação de apoio ao lado da principal.",
      "html": "<button class=\"ds-botao ds-botao-secundario\">Limpar filtros</button>",
      "css": ".ds-botao{display:inline-flex;align-items:center;gap:var(--esp-2);min-height:32px;padding:0 var(--esp-3);border:1px solid transparent;border-radius:var(--canto-botao);font-family:var(--fonte);font-size:var(--tam-base);font-weight:600;cursor:pointer;transition:background-color 150ms var(--curva-saida),border-color 150ms var(--curva-saida)}.ds-botao:focus-visible{outline:2px solid var(--azul);outline-offset:2px}.ds-botao-secundario{background:var(--folha);border-color:var(--linha);color:var(--texto)}.ds-botao-secundario:hover{border-color:var(--linha-tracejada)}"
    },
    {
      "name": "Pílulas de situação",
      "kind": "chip",
      "refersTo": "pilula-atraso",
      "description": "Situação sempre escrita; cinco pares texto/fundo.",
      "html": "<span class=\"ds-pilula ds-atraso\">3d atraso</span> <span class=\"ds-pilula ds-vencendo\">vence 2d</span> <span class=\"ds-pilula ds-informativa\">Em andamento</span> <span class=\"ds-pilula ds-aprovado\">Aprovado</span> <span class=\"ds-pilula ds-neutra\">Histórica</span>",
      "css": ".ds-pilula{display:inline-flex;align-items:center;padding:2px var(--esp-2);border-radius:999px;font-family:var(--fonte);font-size:var(--tam-rotulo);font-weight:600;letter-spacing:.5px;text-transform:uppercase;line-height:1.4;white-space:nowrap}.ds-atraso{background:var(--atraso-fundo);color:var(--atraso-texto)}.ds-vencendo{background:var(--vencendo-fundo);color:var(--vencendo-texto)}.ds-informativa{background:var(--informativa-fundo);color:var(--informativa-texto)}.ds-aprovado{background:var(--aprovado-fundo);color:var(--aprovado-texto)}.ds-neutra{background:var(--neutra-fundo);color:var(--neutra-texto)}"
    },
    {
      "name": "Avatar com iniciais",
      "kind": "custom",
      "refersTo": "avatar-iniciais",
      "description": "Pessoa sem foto: iniciais em azul-escuro sobre azul-avatar; 20, 24 ou 32px.",
      "html": "<span class=\"ds-avatar\" role=\"img\" aria-label=\"Pessoa Fictícia\" style=\"width:24px;height:24px;font-size:10px\">PF</span> <span class=\"ds-avatar\" role=\"img\" aria-label=\"Pessoa Fictícia\" style=\"width:32px;height:32px;font-size:13.4px\">PF</span>",
      "css": ".ds-avatar{display:inline-grid;place-items:center;border-radius:50%;background:var(--azul-avatar);color:var(--azul-escuro);font-family:var(--fonte);font-weight:600;line-height:1;user-select:none}"
    },
    {
      "name": "Barra superior com alternância",
      "kind": "nav",
      "refersTo": "barra-superior",
      "description": "Barra azul: marca, título, alternância Quadro | Lista, ícones de filtro e conta; foco branco.",
      "html": "<header class=\"ds-barra\"><span class=\"ds-marca\">EP</span><span class=\"ds-titulo\">Processos</span><div class=\"ds-alt\" role=\"group\" aria-label=\"Forma de ver os processos\"><button class=\"ds-alt-op\" aria-pressed=\"true\">Quadro</button><button class=\"ds-alt-op\" aria-pressed=\"false\">Lista</button></div><div class=\"ds-acoes\"><button class=\"ds-ico\" aria-label=\"Filtrar\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 5h16l-6 7.5V18l-4 2v-7.5z\"/></svg></button><button class=\"ds-ico\" aria-label=\"Sua conta\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 3.6-6 8-6s8 2 8 6\"/></svg></button></div></header>",
      "css": ".ds-barra{display:flex;align-items:center;gap:var(--esp-4);min-height:52px;padding-right:var(--esp-4);background:var(--azul);color:var(--folha);font-family:var(--fonte)}.ds-marca{width:var(--largura-faixa);text-align:center;font-size:var(--tam-painel);font-weight:700;letter-spacing:.02em}.ds-titulo{font-size:var(--tam-coluna);font-weight:600}.ds-alt{display:inline-flex;padding:1px;border-radius:999px;border:1px solid var(--branco-sobre-azul-borda)}.ds-alt-op{padding:3px var(--esp-3);border:0;border-radius:999px;background:transparent;color:var(--folha);font:600 var(--tam-secundario) var(--fonte);cursor:pointer}.ds-alt-op[aria-pressed=\"true\"]{background:var(--folha);color:var(--azul)}.ds-acoes{display:flex;gap:var(--esp-1);margin-left:auto}.ds-ico{display:inline-grid;place-items:center;width:32px;height:32px;border:0;border-radius:var(--canto-botao);background:transparent;color:var(--folha);cursor:pointer}.ds-ico:hover{background:var(--branco-sobre-azul-hover)}.ds-barra :focus-visible{outline:2px solid var(--folha);outline-offset:2px}"
    },
    {
      "name": "Faixa lateral com linha acesa",
      "kind": "nav",
      "refersTo": "faixa-item-ativo",
      "description": "Navegação por ícones; a área atual ganha azul-claro e a linha acesa de 2px na borda.",
      "html": "<nav class=\"ds-faixa\" aria-label=\"Áreas do sistema\"><button class=\"ds-item\" aria-label=\"Quadro\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"5\" height=\"16\" rx=\"1.5\"/><rect x=\"10\" y=\"4\" width=\"5\" height=\"11\" rx=\"1.5\"/><rect x=\"17\" y=\"4\" width=\"4\" height=\"7\" rx=\"1.5\"/></svg></button><button class=\"ds-item\" aria-label=\"Lista\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01\"/></svg></button><button class=\"ds-item\" aria-label=\"Reuniões\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/></svg></button></nav>",
      "css": ".ds-faixa{display:flex;flex-direction:column;align-items:center;gap:var(--esp-1);width:var(--largura-faixa);padding:var(--esp-3) 0;background:var(--folha);border-right:1px solid var(--linha)}.ds-item{position:relative;display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:var(--canto);background:transparent;color:var(--icone-inativo);cursor:pointer;transition:color 150ms var(--curva-saida),background-color 150ms var(--curva-saida)}.ds-item:hover{color:var(--texto-2);background:var(--fundo)}.ds-item[aria-current=\"page\"]{color:var(--azul);background:var(--azul-claro)}.ds-item[aria-current=\"page\"]::after{content:'';position:absolute;top:8px;right:-8px;bottom:8px;border-right:var(--linha-acesa)}.ds-item:focus-visible{outline:2px solid var(--azul);outline-offset:2px}"
    },
    {
      "name": "Bloco tracejado de estado vazio",
      "kind": "card",
      "refersTo": "bloco-tracejado",
      "description": "Espaço vazio que convida a uma ação: o que houve, o que fazer e o botão.",
      "html": "<section class=\"ds-vazio\"><h2 class=\"ds-vazio-t\">Nenhum processo cadastrado ainda.</h2><p class=\"ds-vazio-p\">Cadastre o primeiro ou importe a planilha atual.</p><button class=\"ds-vazio-b\">Cadastrar processo</button></section>",
      "css": ".ds-vazio{display:flex;flex-direction:column;align-items:center;gap:var(--esp-2);max-width:420px;padding:var(--esp-6) var(--esp-5);border:1px dashed var(--linha-tracejada);border-radius:var(--canto);background:var(--fundo);text-align:center;font-family:var(--fonte);font-size:var(--tam-base);color:var(--texto)}.ds-vazio-t{margin:0;font-size:var(--tam-coluna);font-weight:600;text-wrap:balance}.ds-vazio-p{margin:0 0 var(--esp-3);color:var(--texto-2)}.ds-vazio-b{min-height:32px;padding:0 var(--esp-3);border:0;border-radius:var(--canto-botao);background:var(--azul);color:var(--folha);font:600 var(--tam-base) var(--fonte);cursor:pointer}.ds-vazio-b:hover{background:var(--azul-escuro)}.ds-vazio-b:focus-visible{outline:2px solid var(--azul);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "O Quadro de Etapas com Linha Acesa",
    "overview": "Ferramenta de trabalho diário para uma equipe pequena que acompanha processos etapa por etapa. O mundo é um quadro calmo: área de trabalho azul-acinzentada clara, folhas brancas com bordas de 1px quase invisíveis e um único traço azul de 2px, a linha acesa, que marca o que está em foco ou é atual (área ativa da faixa lateral hoje; cartão escolhido, etapa atual, aba ativa e campo com foco quando essas peças existirem). Todo o resto fica quieto para que os alertas de prazo saltem.\n\nA densidade é de ferramenta: base de 13px, passos de espaçamento de 4 a 32px, controles de 32px de altura. A cor saturada aparece só onde carrega informação (situação, tipo de registro, macroprocesso); o azul principal fica reservado à barra superior, à ação principal e à linha acesa. Códigos que a equipe confere (siglas, versões, datas, contagens) usam fonte mono com números tabulares.\n\nA direção foi fixada pelo brief aprovado (`.scratch/identidade-visual.md`, 2026-10-07). A inspiração são editores de fluxo e quadros de processo, só em cor e forma. Recusa explícita: o painel administrativo genérico de cartões com sombra e cores espalhadas. Só tema claro.\n\n**Estado da construção.** O que já existe em código: tokens, fontes, ícones SVG próprios, botões, pílulas, avatar, moldura (faixa lateral + barra superior) e o estado vazio do Quadro. Cartões, colunas, painel de detalhe, caminho de etapas, barrinhas de tipo, quadradinhos de macroprocesso, caixas de aviso e animações estão definidos no brief e, em parte, já como tokens; nas seções abaixo aparecem marcados como **(planejado)**.",
    "keyCharacteristics": [
      "Um único destaque azul de 2px (linha acesa) acompanha o foco; nada mais compete com ele.",
      "Folhas brancas planas com borda de 1px em `linha`; sem sombra em nada que não flutue.",
      "Cor saturada só com significado, e sempre acompanhada de texto ou rótulo acessível.",
      "Escala de texto fechada em seis tamanhos (11 a 20px), base 13px.",
      "Ícones desenhados no projeto: traço 1,75 numa grade de 24, cantos e pontas arredondados."
    ],
    "rules": [
      {
        "name": "A Regra da Linha Acesa",
        "body": "O traço azul de 2px (`--linha-acesa`) marca só o que está em foco ou é atual, um por região. Ele compensa o respiro para nada \"pular\" de lugar.",
        "section": "colors"
      },
      {
        "name": "A Regra da Cor com Significado",
        "body": "Cor saturada só onde diz algo: situação nas pílulas, tipo nas barrinhas, macroprocesso nos quadradinhos, contagens no rodapé do cartão. Vermelho, âmbar e verde ficam com a situação (e com os ícones de dias e versões no rodapé do cartão, que o brief liga a prazo e aprovação); por isso macroprocessos e barrinhas de tipo não usam nenhum deles. A cor nunca fala sozinha: sempre há texto ou rótulo acessível.",
        "section": "colors"
      },
      {
        "name": "A Regra do Branco Translúcido",
        "body": "Sobre a barra azul, branco translúcido só em borda e em hover de ícone, nunca como fundo atrás de texto: derrubaria o contraste do texto branco.",
        "section": "colors"
      },
      {
        "name": "A Regra do Arquivo Único",
        "body": "Códigos de cor só existem em `src/styles/tokens.css`; todo o resto usa as variáveis.",
        "section": "colors"
      },
      {
        "name": "A Regra da Escala Fechada",
        "body": "Seis tamanhos (`--tam-rotulo` a `--tam-pagina`), nenhum fora deles. Hierarquia vem de peso e cor antes de tamanho.",
        "section": "typography"
      },
      {
        "name": "A Regra do Mono para o que se Confere",
        "body": "Todo código, versão, data ou contagem vai em IBM Plex Mono com números tabulares; texto corrido nunca.",
        "section": "typography"
      },
      {
        "name": "A Regra do Plano por Padrão",
        "body": "Cartões, colunas e faixas não têm sombra. Sombra existe só em superfície que flutua sobre outra.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** usar só as variáveis de `src/styles/tokens.css`; nenhum código de cor fora dele.",
      "**Do** reservar `azul` para barra superior, ação principal, linha acesa e foco.",
      "**Do** marcar o que está em foco ou é atual com a linha acesa de 2px em `azul`, uma por região.",
      "**Do** acompanhar toda cor de significado com texto ou rótulo acessível.",
      "**Do** escrever siglas, versões, datas e contagens em IBM Plex Mono com números tabulares.",
      "**Do** usar borda tracejada em `linha-tracejada` para espaço vazio que convida a uma ação.",
      "**Do** desenhar ícones novos no `Icone.tsx`: SVG em grade de 24, traço 1,75, pontas arredondadas.",
      "**Do** trocar o contorno de foco para branco sobre fundo `azul`."
    ],
    "donts": [
      "**Don't** pôr sombra em cartões, colunas ou faixas; sombra só no que flutua.",
      "**Don't** usar vermelho, âmbar ou verde em macroprocessos, barrinhas de tipo ou decoração; esses tons dizem situação.",
      "**Don't** pôr branco translúcido como fundo atrás de texto na barra azul.",
      "**Don't** criar tamanhos de texto fora da escala de seis passos.",
      "**Don't** usar caractere de texto como ícone (✓, →, ★); o ícone é sempre SVG do `Icone.tsx`.",
      "**Don't** adicionar pacote de ícones ou de fontes sem ADR."
    ]
  }
}
